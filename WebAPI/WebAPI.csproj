<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.22" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Business\Business.csproj" />
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <!-- Sandbox'u Build çıktısı yanındaki sandbox/ klasörüne koy -->
  <Target Name="PublishCSharpSandboxOnBuild" AfterTargets="Build">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\CSharpSandbox\CSharpSandbox.csproj&quot; -c $(Configuration) -o &quot;$(OutputPath)sandbox&quot; --no-self-contained --nologo -v quiet" />
  </Target>

  <!-- VS Publish sırasında sandbox/ klasörünü publish dizinine koy -->
  <Target Name="PublishCSharpSandboxOnPublish" AfterTargets="Publish">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\CSharpSandbox\CSharpSandbox.csproj&quot; -c $(Configuration) -o &quot;$(PublishDir)sandbox&quot; --no-self-contained --nologo -v quiet" />
  </Target>

  <ItemGroup>
    <Folder Include="wwwroot\uploads\profiles\" />
    <Folder Include="wwwroot\uploads\problems\" />
    <Folder Include="wwwroot\uploads\problems\" />
    <Folder Include="wwwroot\uploads\problems\" />
    <Folder Include="wwwroot\uploads\profiles\" />
  </ItemGroup>

</Project>
