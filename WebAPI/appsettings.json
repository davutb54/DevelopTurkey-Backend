{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"ExceptionFileLogging": {
		"Enabled": true,
		"BasePath": "Logs",
		"CreatePerExceptionTypeFolder": true,
		"WriteAllExceptionsFile": true,
		"FilePrefix": "exceptions"
	},
	"AllowedHosts": "*",
	"ConnectionStrings": {
		"DefaultConnection": "REPLACE_IN_ENV"
	},
	"TokenOptions": {
		"Audience": "REPLACE_IN_ENV",
		"Issuer": "REPLACE_IN_ENV",
		"AccessTokenExpiration": 60,
		"SecurityKey": "REPLACE_IN_ENV"
	},
	"EmailOptions": {
		"SmtpServer": "smtp.gmail.com",
		"SmtpPort": 587,
		"SenderName": "Türkiye'yi Geliştirme Platformu",
		"SenderEmail": "turkiyeyigelistirmeplatformu26@gmail.com",
		"SenderPassword": "REPLACE_IN_ENV"
	},
	"ApiSettings": {
		"SiteToken": "REPLACE_IN_ENV"
	},
	"CaptchaOptions": {
		"SecretKey": "REPLACE_IN_ENV"
	},
	"GoogleAuth": {
		"ClientId": "REPLACE_IN_ENV"
	},
	"KillSwitch": {
		"DefaultState": "none"
	},
	"CSharpSandbox": {
		"DllPath": ""
	},
	"Cors": {
		"AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
	},
	"BootstrapAdmin": {
		"Enabled": true,
		"Username": "REPLACE_IN_ENV",
		"Email": "REPLACE_IN_ENV",
		"Name": "REPLACE_IN_ENV",
    "Surname": "REPLACE_IN_ENV",
		"DefaultPassword": "REPLACE_IN_ENV"
	},
	"Sqids": {
		"Alphabet": "REPLACE_IN_ENV",
		"MinLength": 8
	},
	"MediaCleanup": {
		"RunAtHour": 3,
		"QuarantineDays": 7
	}
}